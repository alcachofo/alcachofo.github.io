  "type": "module",
  "scripts": {
    "analyze": "next experimental-analyze",
    "build": "node scripts/covers.mjs && next build && bash ./_flatten.sh",
    "build:mdx": "content-collections build",
    "check": "bun lint && bun typecheck && bun format:check && bun knip && bun check:i18n && bun lint:spell",
    "check:i18n": "i18n-check -s en -l ./src/i18n/messages -u ./src -f next-intl",
    "clean": "rm -rf .content-collections .next coverage node_modules playwright-report test-results next-env.d.ts tsconfig.tsbuildinfo",
    "dev": "next dev -p 3000",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip-bun",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:spell": "cspell .",
    "typecheck": "tsc --noEmit",
    "typegen": "bun build:mdx && next typegen",
    "covers": "node scripts/covers.mjs"
  },
